# rafals - modele du fichier .env (reglages et mots de passe)
# installer.bat fabrique le vrai fichier .env a partir de celui-ci, avec des mots de passe tires au hasard.
# Le fichier .env ne part JAMAIS sur GitHub (voir .gitignore) ; celui-ci, oui : il ne contient aucun secret.
# Les valeurs __ALEATOIRE__ sont remplacees automatiquement. Ne rien changer d'autre sans savoir pourquoi.

# Base de donnees : compte administrateur (creation des tables, inspection)
POSTGRES_DB=rafals_db
POSTGRES_USER=rafals_user
POSTGRES_PASSWORD=__ALEATOIRE_MOT_DE_PASSE__

# Base de donnees : compte application (serveur et tests)
RAFALS_APP_USER=rafals_app
RAFALS_APP_PASSWORD=__ALEATOIRE_MOT_DE_PASSE__

# Stockage de fichiers (Garage sur le PC)
GARAGE_RPC_SECRET=__ALEATOIRE_HEX_64__
GARAGE_ADMIN_TOKEN=__ALEATOIRE_JETON__
S3_ADRESSE=http://garage:3900
S3_REGION=garage
S3_COMPARTIMENT=rafals
S3_CLE_ACCES=__ALEATOIRE_CLE_GARAGE__
S3_CLE_SECRETE=__ALEATOIRE_HEX_64__

# Notifications sur le telephone : une paire de cles fabriquee pour ce PC
VAPID_PUBLIQUE=__CLE_VAPID_PUBLIQUE__
VAPID_PRIVEE=__CLE_VAPID_PRIVEE__

# Envoi des mails. Vide (sur le PC) : tout arrive dans Mailpit, http://localhost:8025, rien ne part pour de vrai.
# En ligne seulement, avec le compte Brevo de rafals (jamais sur un PC d'essai : de vrais mails partiraient) :
# SMTP_HOTE=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_UTILISATEUR=
# SMTP_MOT_DE_PASSE=
# MAIL_EXPEDITEUR=rafals <ne-pas-repondre@rafals.fr>

# Services exterieurs : vides = rafals marche sans eux (mode essai).
# A remplir seulement avec SES PROPRES comptes, jamais ceux d'un autre :
# - Stripe (paiement par carte) : cle secrete et secret du webhook, depuis dashboard.stripe.com (mode test)
# STRIPE_CLE_SECRETE=
# STRIPE_SECRET_WEBHOOK=
# - INPI (creation d'auto-entreprise) : sans compte, rafals utilise son mode demonstration
# INPI_IDENTIFIANT=
# INPI_MOT_DE_PASSE=
# - URSSAF (declaration du chiffre d'affaires) : sans compte, le bouton reste verrouille
# URSSAF_IDENTIFIANT=
# URSSAF_SECRET=

# Identite de rafals sur ses factures de commission. Vides : pas de facture de commission pour l'instant.
RAFALS_NOM=
RAFALS_SIRET=
RAFALS_ADRESSE=
