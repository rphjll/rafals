# rafals - reglages et mots de passe (base locale de developpement)
# Modele : copier en .env et remplacer les mots de passe.

# Base de donnees : compte administrateur (creation des tables, inspection)
POSTGRES_DB=rafals_db
POSTGRES_USER=rafals_user
POSTGRES_PASSWORD=a_remplacer

# Base de donnees : compte application (serveur et tests, cree au lot 0.2)
RAFALS_APP_USER=rafals_app
RAFALS_APP_PASSWORD=a_remplacer
