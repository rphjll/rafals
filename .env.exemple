# rafals - reglages et mots de passe (base locale de developpement)
# Modele : copier en .env et remplacer les mots de passe.

# Base de donnees : compte administrateur (creation des tables, inspection)
POSTGRES_DB=rafals_db
POSTGRES_USER=rafals_user
POSTGRES_PASSWORD=a_remplacer

# Base de donnees : compte application (serveur et tests, cree au lot 0.2)
RAFALS_APP_USER=rafals_app
RAFALS_APP_PASSWORD=a_remplacer

# Stockage de fichiers (Garage sur le PC, S3 d'OVH en ligne)
GARAGE_RPC_SECRET=a_remplacer
GARAGE_ADMIN_TOKEN=a_remplacer
S3_ADRESSE=http://garage:3900
S3_REGION=garage
S3_COMPARTIMENT=rafals
S3_CLE_ACCES=a_remplacer
S3_CLE_SECRETE=a_remplacer

# Paiement par carte (Stripe, lot 5.1) : cles du tableau de bord de Stripe (mode test pour le PC).
# Vides : le paiement par carte est indisponible, les especes restent possibles.
STRIPE_CLE_SECRETE=
STRIPE_SECRET_WEBHOOK=
